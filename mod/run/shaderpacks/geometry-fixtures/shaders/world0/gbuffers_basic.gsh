layout(triangles) in; layout(triangle_strip, max_vertices = 257) out; layout(rgba32f, binding = 0) uniform image2D fixtureImage; layout(std430, binding = 1) buffer FixtureData { uint writes; }; void main() { uint id = uint(gl_PrimitiveIDIn); gl_Layer = int(id); imageStore(fixtureImage, ivec2(id, 0), vec4(float(id))); atomicAdd(writes, 1u); if (id >= 0u) { EmitVertex(); EmitVertex(); EmitVertex(); EndPrimitive(); EmitVertex(); EmitVertex(); EmitVertex(); EndPrimitive(); EmitVertex(); EmitVertex(); EmitVertex(); EndPrimitive(); } }
