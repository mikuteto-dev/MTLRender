layout(triangles) in vec4 inputData[]; layout(triangle_strip, max_vertices = 3) out vec4 outputData; layout(rgba32f, binding = 0) uniform image2D fixtureImage; layout(std430, binding = 1) buffer Data { uint values[]; } data; void main() { imageStore(fixtureImage, ivec2(0, 0), vec4(0.0)); data = data; EmitVertex(); EmitVertex(); EmitVertex(); EndPrimitive(); }
